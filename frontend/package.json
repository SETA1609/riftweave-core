{
  "name": "riftweave-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "The Riftweave frontend: an Angular app over the HTTP API (docs/backend/frontend.md).",
  "license": "Apache-2.0",
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "ng test --watch=false",
    "generate": "npx --yes openapi-typescript@7.13.0 ${RIFTWEAVE_API:-http://127.0.0.1:8080}/openapi.json -o src/api/openapi.d.ts"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "openapi-fetch": "0.17.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
