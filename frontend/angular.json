{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false, "packageManager": "npm" },
  "newProjectRoot": "projects",
  "projects": {
    "riftweave": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "assets": [{ "glob": "**/*", "input": "public" }],
            "define": { "RIFTWEAVE_API": "null" }
          },
          "configurations": {
            "api": { "define": { "RIFTWEAVE_API": "''" } }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "riftweave:build" },
          "configurations": { "api": { "buildTarget": "riftweave:build:api" } }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": { "buildTarget": "riftweave:build", "tsConfig": "tsconfig.json", "runner": "vitest" }
        }
      }
    }
  }
}
