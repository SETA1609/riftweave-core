{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false, "packageManager": "npm" },
  "newProjectRoot": "projects",
  "projects": {
    "riftweave": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "assets": [{ "glob": "**/*", "input": "public" }, { "glob": "{us,de,es}.svg", "input": "node_modules/flag-icons/flags/4x3", "output": "flags" }],
            "define": { "RIFTWEAVE_API": "null", "RIFTWEAVE_RULES_VERSION": "'dev'", "RIFTWEAVE_SERVICE_WORKER": "false", "RIFTWEAVE_DEV": "false" }
          },
          "configurations": {
            "development": { "define": { "RIFTWEAVE_API": "null", "RIFTWEAVE_RULES_VERSION": "'dev'", "RIFTWEAVE_SERVICE_WORKER": "false", "RIFTWEAVE_DEV": "true" } },
            "api": { "define": { "RIFTWEAVE_API": "''", "RIFTWEAVE_RULES_VERSION": "'dev'", "RIFTWEAVE_SERVICE_WORKER": "false", "RIFTWEAVE_DEV": "true" } },
            "pages": {
              "serviceWorker": "ngsw-config.json",
              "define": { "RIFTWEAVE_API": "null", "RIFTWEAVE_RULES_VERSION": "'dev'", "RIFTWEAVE_SERVICE_WORKER": "true", "RIFTWEAVE_DEV": "false" }
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "riftweave:build:development" },
          "configurations": { "api": { "buildTarget": "riftweave:build:api" } }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": { "buildTarget": "riftweave:build", "tsConfig": "tsconfig.json", "runner": "vitest" }
        }
      }
    }
  }
}
