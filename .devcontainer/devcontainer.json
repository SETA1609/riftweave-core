{
  "name": "riftweave agent",
  "image": "riftweave-agent:devcontainer",
  "initializeCommand": "./scripts/devcontainer-image.sh",
  "workspaceMount": "source=${localWorkspaceFolder},target=/src,type=bind",
  "workspaceFolder": "/src",
  "mounts": [
    "source=personal-agent-home,target=/home/agent,type=volume"
  ],
  "remoteUser": "agent",
  "updateRemoteUserUID": true,
  "overrideCommand": true
}
