{
  "$schema": "./command.schema.json",
  "name": "spellcraft",
  "summary": "Spell knowledge: check a crafted spell against the effects the caster knows, learn a spell's craftable effects, or research one effect.",
  "doc": "docs/core/casting.md",
  "input_schema": {
    "type": "object",
    "properties": {
      "op": {
        "type": "string",
        "enum": [
          "craft",
          "learn",
          "research"
        ]
      },
      "caster": {
        "type": "object",
        "properties": {
          "known": {
            "type": "array",
            "items": {
              "$ref": "common.json#/definitions/ref"
            },
            "description": "The effect refs the caster knows."
          },
          "skills": {
            "$ref": "common.json#/definitions/skills"
          },
          "attributes": {
            "$ref": "common.json#/definitions/attributes"
          }
        },
        "required": [
          "known"
        ],
        "additionalProperties": false
      },
      "spell": {
        "oneOf": [
          {
            "$ref": "common.json#/definitions/key",
            "description": "learn: the spell learned."
          },
          {
            "type": "object",
            "description": "craft: the recipe.",
            "properties": {
              "color": {
                "type": "string",
                "enum": [
                  "red",
                  "orange",
                  "yellow",
                  "green",
                  "blue",
                  "indigo",
                  "violet",
                  "white",
                  "black"
                ]
              },
              "effects": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "../../ruleset/schemas/schema.json#/definitions/appliedEffect"
                }
              }
            },
            "required": [
              "color",
              "effects"
            ],
            "additionalProperties": false
          }
        ]
      },
      "effect": {
        "$ref": "common.json#/definitions/ref",
        "description": "research: the effect researched."
      },
      "color": {
        "type": "string",
        "enum": [
          "red",
          "orange",
          "yellow",
          "green",
          "blue",
          "indigo",
          "violet",
          "white",
          "black"
        ],
        "description": "research: the color to roll for an effect with none."
      },
      "modifiers": {
        "$ref": "common.json#/definitions/modifiers"
      },
      "roll": {
        "$ref": "common.json#/definitions/d100"
      }
    },
    "required": [
      "op",
      "caster"
    ],
    "additionalProperties": false
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "valid": {
        "type": "boolean"
      },
      "rejected": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "common.json#/definitions/ref"
            },
            "reason": {
              "type": "string",
              "enum": [
                "channel",
                "uncraftable",
                "excluded_parameter",
                "unknown",
                "off_color"
              ]
            }
          },
          "required": [
            "effect",
            "reason"
          ],
          "additionalProperties": false
        }
      },
      "mana": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 0
      },
      "cast_threshold": {
        "type": [
          "integer",
          "null"
        ]
      },
      "craft_threshold": {
        "type": [
          "integer",
          "null"
        ]
      },
      "skill_ok": {
        "type": "boolean"
      },
      "taught": {
        "type": "array",
        "items": {
          "$ref": "common.json#/definitions/ref"
        }
      },
      "known": {
        "type": "array",
        "items": {
          "$ref": "common.json#/definitions/ref"
        }
      },
      "outcome": {
        "type": "string",
        "enum": [
          "learned",
          "failed",
          "refused"
        ]
      },
      "reason": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "enum": [
              "uncraftable",
              "known",
              "no_color",
              "skill"
            ]
          }
        ]
      },
      "check": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "properties": {
              "target": {
                "type": "integer"
              },
              "success": {
                "type": "boolean"
              },
              "margin": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "tags": {
                "$ref": "common.json#/definitions/tags"
              }
            },
            "required": [
              "target",
              "success",
              "margin",
              "tags"
            ],
            "additionalProperties": false
          }
        ]
      },
      "days": {
        "type": "integer",
        "minimum": 0
      },
      "cost": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "common.json#/definitions/cost"
          }
        ]
      }
    },
    "additionalProperties": false
  }
}
