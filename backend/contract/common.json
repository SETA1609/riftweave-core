{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Command contract: shared definitions",
  "definitions": {
    "error": {
      "type": "object",
      "description": "Any command may return this instead of its result.",
      "properties": { "error": { "type": "string", "minLength": 1 } },
      "required": ["error"],
      "additionalProperties": false
    },
    "attributes": {
      "type": "object",
      "description": "Attribute values by ability key; a missing attribute reads as 0.",
      "propertyNames": { "$ref": "../../ruleset/schemas/schema.json#/definitions/ability" },
      "additionalProperties": { "type": "integer" }
    },
    "skills": {
      "type": "object",
      "description": "Skill values by skill key.",
      "propertyNames": { "pattern": "^[a-z_][a-z0-9_]*$" },
      "additionalProperties": { "type": "integer" }
    },
    "actor": {
      "type": "object",
      "properties": {
        "attributes": { "$ref": "#/definitions/attributes" },
        "skills": { "$ref": "#/definitions/skills" },
        "level": { "type": "integer", "minimum": 1 },
        "growth": {
          "type": "object",
          "properties": {
            "hp": { "type": "integer", "minimum": 0 },
            "mp": { "type": "integer", "minimum": 0 },
            "sp": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pools": {"type": "object", "properties": {"hp": {"type": "integer", "minimum": 0}, "mp": {"type": "integer", "minimum": 0}, "sp": {"type": "integer", "minimum": 0}}, "required": ["hp", "mp", "sp"], "additionalProperties": false},
    "item_instance": {"type": "object", "description": "One item the actor holds: an instance that points at a row.", "properties": {"id": {"type": "integer", "minimum": 1}, "base": {"$ref": "#/definitions/ref"}, "material": {"$ref": "#/definitions/ref"}, "size": {"type": "string", "enum": ["undersized", "normal", "oversized"]}, "added_effects": {"type": "array", "description": "The applied effects added to this instance, such as an enchantment or a coating", "items": {"$ref": "../../ruleset/schemas/schema.json#/definitions/appliedEffect"}}, "quantity": {"type": "integer", "minimum": 1}}, "required": ["id", "base", "added_effects", "quantity"], "additionalProperties": false},
    "stored_actor": {"type": "object", "description": "What a session stores for its actor (docs/core/state.md#the-stored-actor). Maximum pools and derived stats are computed, not stored.", "properties": {"attributes": {"$ref": "#/definitions/attributes"}, "level": {"type": "integer", "minimum": 1}, "xp": {"type": "integer", "minimum": 0}, "skills": {"$ref": "#/definitions/skills"}, "tags": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/key"}}, "growth": {"$ref": "#/definitions/pools"}, "resources": {"type": "object", "properties": {"hp": {"type": "integer", "minimum": 0}, "mp": {"type": "integer", "minimum": 0}, "sp": {"type": "integer", "minimum": 0}, "ap": {"type": "integer", "minimum": 0}}, "required": ["hp", "mp", "sp", "ap"], "additionalProperties": false}, "conditions": {"type": "array", "items": {"type": "object", "properties": {"key": {"$ref": "#/definitions/key"}, "stacks": {"type": "integer", "minimum": 1}}, "required": ["key", "stacks"], "additionalProperties": false}}, "modifiers": {"type": "array", "items": {"type": "object", "properties": {"modifier": {"$ref": "../../ruleset/schemas/schema.json#/definitions/modifier"}, "turns_elapsed": {"type": "integer", "minimum": 0}}, "required": ["modifier", "turns_elapsed"], "additionalProperties": false}}, "flags": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/key"}}, "perks": {"type": "object", "description": "Rank by feature key (docs/core/state.md#the-stored-actor).", "additionalProperties": {"type": "integer", "minimum": 1}}, "spells": {"type": "array", "uniqueItems": true, "description": "Known spells, by spell key.", "items": {"$ref": "#/definitions/key"}}, "known_effects": {"type": "array", "uniqueItems": true, "description": "Effects the actor knows for spellcrafting, by effect key.", "items": {"$ref": "#/definitions/key"}}, "coins": {"type": "integer", "minimum": 0, "description": "Coins, in copper."}, "inventory": {"type": "array", "items": {"$ref": "#/definitions/item_instance"}}, "equipped": {"type": "object", "description": "An inventory id by slot.", "propertyNames": {"$ref": "#/definitions/key"}, "additionalProperties": {"type": "integer", "minimum": 1}}}, "required": ["attributes", "level", "xp", "skills", "tags", "growth", "resources", "conditions", "modifiers", "flags", "inventory", "equipped"], "additionalProperties": false},
    "session_step": {"type": "object", "description": "One command in a session's log.", "properties": {"command": {"$ref": "#/definitions/key"}, "input": {"type": "object"}, "as": {"type": "string", "enum": ["attacker", "defender"], "description": "The actor's side of a combat step; default attacker."}}, "required": ["command", "input"], "additionalProperties": false},
    "session": {"type": "object", "description": "One run: a starting actor, a log of commands, and the current snapshot (docs/core/state.md).", "properties": {"rules_version": {"type": "string", "description": "The rules the session was started on, or last replayed under (docs/backend/sessions.md#the-rules-version)."}, "ruleset": {"type": "object", "properties": {"modules": {"type": "array", "items": {"$ref": "#/definitions/key"}}}, "required": ["modules"], "additionalProperties": false}, "start": {"$ref": "#/definitions/stored_actor"}, "log": {"type": "array", "items": {"$ref": "#/definitions/session_step"}}, "actor": {"$ref": "#/definitions/stored_actor"}, "dev": {"type": "boolean", "const": true, "description": "Present once a dev operation ran (docs/backend/dev-mode.md)."}, "party": {"type": "array", "description": "The characters the GM loaded beside the session's own actor, each with the revision it was loaded at (BE_S07_03, docs/backend/sessions.md#the-party). The session carries them and holds no rule for them.", "items": {"$ref": "#/definitions/party_member"}}}, "required": ["ruleset", "start", "log", "actor"], "additionalProperties": false},
    "character": {"type": "object", "description": "A character file's sync fields (BE_S07_03, docs/backend/files.md#the-character-list): who the character is, which revision, and who changed it last, when.", "properties": {"id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "description": "A UUID made when the character is created; it never changes."}, "name": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1, "description": "Raised by one on every change."}, "changed_by": {"enum": ["gm", "player"], "description": "Who made the last change."}, "changed_at": {"type": "string", "format": "date-time", "description": "When the last change was made, RFC 3339 in UTC."}}, "required": ["id", "name", "revision", "changed_by", "changed_at"], "additionalProperties": false},
    "party_member": {"type": "object", "description": "One character in a session's party: its sync fields as loaded, the actor as loaded, and the actor now.", "properties": {"character": {"$ref": "#/definitions/character"}, "start": {"$ref": "#/definitions/stored_actor"}, "actor": {"$ref": "#/definitions/stored_actor"}}, "required": ["character", "start", "actor"], "additionalProperties": false},
    "creation_draft": {"type": "object", "description": "A character being made (BE_S07_08, docs/backend/creation.md): any steps, in any order.", "properties": {"name": {"type": "string"}, "race": {"$ref": "#/definitions/ref"}, "points": {"type": "object", "description": "Points spent per attribute key; negative when one is lowered under the start, which frees points.", "additionalProperties": {"type": "integer"}}, "background": {"$ref": "#/definitions/ref"}, "creation_perks": {"type": "array", "items": {"$ref": "#/definitions/ref"}}, "tag_skills": {"type": "array", "items": {"$ref": "#/definitions/ref"}}}, "additionalProperties": false},
    "modifiers": {
      "type": "array",
      "items": { "$ref": "../../ruleset/schemas/schema.json#/definitions/modifier" }
    },
    "cost": {
      "type": "object",
      "properties": {
        "quantity": { "type": "integer", "minimum": 0 },
        "unit": { "type": "string", "enum": ["copper", "silver", "gold", "platinum"] }
      },
      "required": ["quantity", "unit"],
      "additionalProperties": false
    },
    "ref": { "$ref": "../../ruleset/schemas/schema.json#/definitions/namespacedRef" },
    "phase": { "$ref": "../../ruleset/schemas/schema.json#/definitions/phase" },
    "key": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
    "d100": { "type": "integer", "minimum": 1, "maximum": 100 },
    "tags": { "type": "array", "items": { "type": "string", "enum": ["crit", "fumble"] } }
  }
}
