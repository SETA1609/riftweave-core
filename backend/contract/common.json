{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Command contract: shared definitions",
  "definitions": {
    "error": {
      "type": "object",
      "description": "Any command may return this instead of its result.",
      "properties": { "error": { "type": "string", "minLength": 1 } },
      "required": ["error"],
      "additionalProperties": false
    },
    "attributes": {
      "type": "object",
      "description": "Attribute values by ability key; a missing attribute reads as 0.",
      "propertyNames": { "$ref": "../../ruleset/schemas/schema.json#/definitions/ability" },
      "additionalProperties": { "type": "integer" }
    },
    "skills": {
      "type": "object",
      "description": "Skill values by skill key.",
      "propertyNames": { "pattern": "^[a-z_][a-z0-9_]*$" },
      "additionalProperties": { "type": "integer" }
    },
    "actor": {
      "type": "object",
      "properties": {
        "attributes": { "$ref": "#/definitions/attributes" },
        "skills": { "$ref": "#/definitions/skills" },
        "level": { "type": "integer", "minimum": 1 },
        "growth": {
          "type": "object",
          "properties": {
            "hp": { "type": "integer", "minimum": 0 },
            "mp": { "type": "integer", "minimum": 0 },
            "sp": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pools": {"type": "object", "properties": {"hp": {"type": "integer", "minimum": 0}, "mp": {"type": "integer", "minimum": 0}, "sp": {"type": "integer", "minimum": 0}}, "required": ["hp", "mp", "sp"], "additionalProperties": false},
    "item_instance": {"type": "object", "description": "One item the actor holds: an instance that points at a row.", "properties": {"id": {"type": "integer", "minimum": 1}, "base": {"$ref": "#/definitions/ref"}, "material": {"$ref": "#/definitions/ref"}, "size": {"type": "string", "enum": ["undersized", "normal", "oversized"]}, "mods": {"type": "array", "items": {"$ref": "../../ruleset/schemas/schema.json#/definitions/appliedEffect"}}, "quantity": {"type": "integer", "minimum": 1}}, "required": ["id", "base", "mods", "quantity"], "additionalProperties": false},
    "stored_actor": {"type": "object", "description": "What a session stores for its actor (docs/core/state.md#the-stored-actor). Maximum pools and derived stats are computed, not stored.", "properties": {"attributes": {"$ref": "#/definitions/attributes"}, "level": {"type": "integer", "minimum": 1}, "xp": {"type": "integer", "minimum": 0}, "skills": {"$ref": "#/definitions/skills"}, "tags": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/key"}}, "growth": {"$ref": "#/definitions/pools"}, "resources": {"type": "object", "properties": {"hp": {"type": "integer", "minimum": 0}, "mp": {"type": "integer", "minimum": 0}, "sp": {"type": "integer", "minimum": 0}, "ap": {"type": "integer", "minimum": 0}}, "required": ["hp", "mp", "sp", "ap"], "additionalProperties": false}, "conditions": {"type": "array", "items": {"type": "object", "properties": {"key": {"$ref": "#/definitions/key"}, "stacks": {"type": "integer", "minimum": 1}}, "required": ["key", "stacks"], "additionalProperties": false}}, "modifiers": {"type": "array", "items": {"type": "object", "properties": {"modifier": {"$ref": "../../ruleset/schemas/schema.json#/definitions/modifier"}, "turns_elapsed": {"type": "integer", "minimum": 0}}, "required": ["modifier", "turns_elapsed"], "additionalProperties": false}}, "flags": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/key"}}, "inventory": {"type": "array", "items": {"$ref": "#/definitions/item_instance"}}, "equipped": {"type": "object", "description": "An inventory id by slot.", "propertyNames": {"$ref": "#/definitions/key"}, "additionalProperties": {"type": "integer", "minimum": 1}}}, "required": ["attributes", "level", "xp", "skills", "tags", "growth", "resources", "conditions", "modifiers", "flags", "inventory", "equipped"], "additionalProperties": false},
    "session_step": {"type": "object", "description": "One command in a session's log.", "properties": {"command": {"$ref": "#/definitions/key"}, "input": {"type": "object"}, "as": {"type": "string", "enum": ["attacker", "defender"], "description": "The actor's side of a combat step; default attacker."}}, "required": ["command", "input"], "additionalProperties": false},
    "session": {"type": "object", "description": "One run: a starting actor, a log of commands, and the current snapshot (docs/core/state.md).", "properties": {"ruleset": {"type": "object", "properties": {"modules": {"type": "array", "items": {"$ref": "#/definitions/key"}}}, "required": ["modules"], "additionalProperties": false}, "start": {"$ref": "#/definitions/stored_actor"}, "log": {"type": "array", "items": {"$ref": "#/definitions/session_step"}}, "actor": {"$ref": "#/definitions/stored_actor"}, "dev": {"type": "boolean", "const": true, "description": "Present once a dev operation ran (docs/backend/dev-mode.md)."}}, "required": ["ruleset", "start", "log", "actor"], "additionalProperties": false},
    "modifiers": {
      "type": "array",
      "items": { "$ref": "../../ruleset/schemas/schema.json#/definitions/modifier" }
    },
    "cost": {
      "type": "object",
      "properties": {
        "quantity": { "type": "integer", "minimum": 0 },
        "unit": { "type": "string", "enum": ["cp", "sp", "gp", "pp"] }
      },
      "required": ["quantity", "unit"],
      "additionalProperties": false
    },
    "ref": { "$ref": "../../ruleset/schemas/schema.json#/definitions/namespacedRef" },
    "phase": { "$ref": "../../ruleset/schemas/schema.json#/definitions/phase" },
    "key": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
    "d100": { "type": "integer", "minimum": 1, "maximum": 100 },
    "tags": { "type": "array", "items": { "type": "string", "enum": ["crit", "fumble"] } }
  }
}
