{
  "$schema": "./command.schema.json",
  "name": "combat",
  "summary": "One attack from the roll to the HP lost: one attack roll read against the defender's evasion and block bands.",
  "documentation": "docs/core/combat.md",
  "input_schema": {
    "type": "object",
    "properties": {
      "attacker": {
        "type": "object",
        "properties": {
          "skill": {
            "type": "integer"
          },
          "roll": {
            "$ref": "common.json#/definitions/d100"
          },
          "attributes": {
            "$ref": "common.json#/definitions/attributes"
          },
          "flags": {
            "type": "array",
            "items": {
              "$ref": "common.json#/definitions/key"
            },
            "description": "Flags from conditions (prone, blinded, invisible); a situation row with `when` reads them."
          },
          "weapon_properties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The carried weapon's properties, which a maneuver may need."
          },
          "weapon_effects": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "The weapon's on-hit applied effects: armor_pierce, bane, lingering_damage, banish_summoned (docs/core/combat.md#weapon-effects)."
          }
        },
        "additionalProperties": false,
        "required": [
          "skill",
          "roll"
        ]
      },
      "defender": {
        "type": "object",
        "properties": {
          "evasion_skill": {
            "type": "integer"
          },
          "attributes": {
            "$ref": "common.json#/definitions/attributes"
          },
          "armor_dr": {
            "type": "integer",
            "minimum": 0
          },
          "hp": {
            "type": "integer",
            "minimum": 0
          },
          "resist": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "pattern": "^[a-z_][a-z0-9_]*$"
            }
          },
          "shield_dr": {"type": "integer", "minimum": 0, "description": "The carried shield's DR; it adds to armor_dr against types with armor_dr_applies."},
          "shields_skill": {"type": "integer", "description": "The shields skill the block stance's band reads."},
          "stance": {"type": "string", "description": "The stance the defender declared on their turn: dodge (doubles the evasion band) or block (adds a block band; needs shield_dr and shields_skill). Any other value is an error."},
          "creature_type": {
            "$ref": "common.json#/definitions/key",
            "description": "The defender's creature type (undead, beast, ...), which a weapon's bane reads."
          },
          "flags": {
            "type": "array",
            "items": {
              "$ref": "common.json#/definitions/key"
            },
            "description": "Flags from conditions (prone, blinded, invisible); a situation row with `when` reads them."
          },
          "modifiers": {
            "$ref": "common.json#/definitions/modifiers"
          }
        },
        "additionalProperties": false,
        "required": [
          "hp"
        ]
      },
      "damage": {
        "type": "object",
        "properties": {
          "roll": {
            "type": "integer",
            "minimum": 0
          },
          "type": {
            "$ref": "common.json#/definitions/key"
          },
          "ability": { "$ref": "../../ruleset/schemas/schema.json#/definitions/ability", "description": "The attacker attribute whose modifier adds to the roll." }
        },
        "additionalProperties": false,
        "required": [
          "roll",
          "type"
        ]
      },
      "delivery": {
        "type": "string",
        "enum": [
          "single",
          "area",
          "instant"
        ]
      },
      "modifiers": {
        "$ref": "common.json#/definitions/modifiers"
      },
      "range": {
        "type": "string",
        "enum": [
          "melee",
          "ranged"
        ],
        "description": "Default melee."
      },
      "situations": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "$ref": "common.json#/definitions/key"
        },
        "description": "Keys in ruleset/data/combat/situations.json the caller names (cover, flanking, into melee)."
      },
      "called_shot": {
        "$ref": "common.json#/definitions/key",
        "description": "A called_shots key in ruleset/data/combat/situations.json."
      },
      "maneuver": {
        "$ref": "common.json#/definitions/key",
        "description": "A maneuvers key in ruleset/data/maneuvers/core.json: the attack is performed as that maneuver (docs/core/actions.md#maneuvers)."
      }
    },
    "additionalProperties": false,
    "required": [
      "attacker",
      "defender",
      "damage"
    ]
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "outcome": {
        "type": "string",
        "enum": [
          "hit",
          "miss",
          "fumble",
          "evaded",
          "blocked"
        ]
      },
      "target": {
        "type": "integer"
      },
      "margin": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "crit": {
        "type": "boolean"
      },
      "evaded": {
        "type": "boolean"
      },
      "blocked": {
        "type": "boolean"
      },
      "evasion_rate": {
        "type": "integer",
        "minimum": 0,
        "description": "The evasion band: a margin under it is evaded."
      },
      "block_rate": {
        "type": "integer",
        "minimum": 0,
        "description": "The block stance's band, under the evasion band: a margin in it is blocked."
      },
      "stagger_ap": {
        "type": "integer",
        "minimum": 0,
        "description": "Bulwark: AP the attacker loses on their next turn."
      },
      "damage": {
        "type": "integer",
        "minimum": 0
      },
      "hp": {
        "type": "integer",
        "minimum": 0
      },
      "riders": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "common.json#/definitions/ref"
            },
            "event": {
              "type": "string"
            },
            "check": {
              "type": "string"
            },
            "turns": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "description": "A called shot's riders on a hit."
      },
      "counter": {
        "type": "boolean",
        "description": "A riposte: the defender may make one attack at no AP cost."
      },
      "ap": {
        "type": "integer",
        "description": "With a maneuver: the attack's AP plus the maneuver's, at least 1."
      },
      "stamina": {
        "type": "integer",
        "description": "With a maneuver: ap times stamina_per_ap, its cost in real time."
      },
      "effects": {
        "type": "array",
        "items": {
          "type": "object"
        },
        "description": "With a maneuver: its applied effects on a hit, empty on a miss or an evade."
      },
      "weapon_effects": {
        "type": "array",
        "items": {
          "type": "object"
        },
        "description": "With weapon effects: those that land on a hit (docs/core/combat.md#weapon-effects), empty on a miss, an evade, or a block. Left out without weapon effects."
      }
    },
    "additionalProperties": false,
    "required": [
      "outcome",
      "target",
      "margin",
      "crit",
      "evaded",
      "blocked",
      "evasion_rate",
      "block_rate",
      "damage",
      "hp"
    ]
  }
}
