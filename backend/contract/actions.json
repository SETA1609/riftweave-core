{
  "$schema": "./command.schema.json",
  "name": "actions",
  "summary": "The AP pool and the cost of a list of actions, in AP and in real-time stamina.",
  "doc": "docs/core/actions.md",
  "input_schema": {
    "type": "object",
    "properties": {
      "actor": {
        "$ref": "common.json#/definitions/actor"
      },
      "actions": {
        "type": "array",
        "items": {
          "$ref": "common.json#/definitions/key"
        }
      },
      "modifiers": {
        "$ref": "common.json#/definitions/modifiers"
      }
    },
    "additionalProperties": false,
    "required": [
      "actor"
    ]
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "pool": {
        "type": "integer"
      },
      "cost": {
        "type": "integer"
      },
      "stamina": {
        "type": "integer",
        "description": "The cost in stamina for a real-time client: AP times stamina_per_ap."
      }
    },
    "additionalProperties": false,
    "required": [
      "pool",
      "cost"
    ]
  }
}
