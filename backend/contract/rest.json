{
  "$schema": "./command.schema.json",
  "name": "rest",
  "summary": "Recover resources and clear conditions for one rest occasion.",
  "doc": "docs/core/rest.md",
  "input_schema": {
    "type": "object",
    "properties": {
      "occasion": {
        "$ref": "common.json#/definitions/key"
      },
      "actor": {
        "$ref": "common.json#/definitions/actor"
      },
      "modifiers": {
        "$ref": "common.json#/definitions/modifiers"
      },
      "current": {
        "type": "object",
        "properties": {
          "hp": {
            "type": "integer",
            "minimum": 0
          },
          "mp": {
            "type": "integer",
            "minimum": 0
          },
          "stamina": {
            "type": "integer",
            "minimum": 0
          },
          "ap": {
            "type": "integer",
            "minimum": 0
          },
          "toxicity": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "max": {
        "type": "object",
        "properties": {
          "stamina": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "conditions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "$ref": "common.json#/definitions/key"
            },
            "duration": {
              "type": "string",
              "enum": [
                "turns",
                "uses",
                "while_equipped",
                "while_applied",
                "permanent"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "key",
            "duration"
          ]
        }
      },
      "running": {
        "type": "object",
        "description": "The effects running on the actor, as consume returns them.",
        "properties": {
          "ticks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "origin": {
                  "type": "string"
                },
                "pool": {
                  "type": "string"
                },
                "magnitude": {
                  "type": "integer"
                },
                "seconds_left": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            }
          },
          "modifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "origin": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "operation": {
                  "type": "string"
                },
                "value": {
                  "type": "integer"
                },
                "seconds_left": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "meal": {
        "$ref": "common.json#/definitions/key",
        "description": "A food eaten during the rest; its effects start when the rest ends (docs/core/rest.md#food-at-rest)."
      }
    },
    "additionalProperties": false,
    "required": [
      "occasion",
      "actor",
      "current"
    ]
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "hp": {
        "type": "integer"
      },
      "mp": {
        "type": "integer"
      },
      "stamina": {
        "type": "integer"
      },
      "ap": {
        "type": "integer"
      },
      "conditions": {
        "type": "array",
        "items": {
          "$ref": "common.json#/definitions/key"
        }
      },
      "toxicity": {
        "type": "integer",
        "minimum": 0
      },
      "running": {
        "type": "object",
        "description": "The running effects after the rest: food cleared by the occasion's food row, then the meal's.",
        "properties": {
          "ticks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "origin": {
                  "type": "string"
                },
                "pool": {
                  "type": "string"
                },
                "magnitude": {
                  "type": "integer"
                },
                "seconds_left": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            }
          },
          "modifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                },
                "origin": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "operation": {
                  "type": "string"
                },
                "value": {
                  "type": "integer"
                },
                "seconds_left": {
                  "type": "integer"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "refused": {
        "type": "array",
        "items": {
          "$ref": "common.json#/definitions/key"
        },
        "description": "A meal that is not food."
      }
    },
    "additionalProperties": false,
    "required": [
      "hp",
      "mp",
      "stamina",
      "ap",
      "conditions"
    ]
  }
}
