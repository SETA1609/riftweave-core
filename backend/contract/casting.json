{
  "$schema": "./command.schema.json",
  "name": "casting",
  "summary": "Cast one spell: the gate, the mana and reagent cost, one resolution on the spell's color skill with the armor penalty, then the effects, concentration, and dispel.",
  "documentation": "docs/core/casting.md",
  "input_schema": {
    "type": "object",
    "properties": {
      "spell": {
        "$ref": "common.json#/definitions/key"
      },
      "caster": {
        "type": "object",
        "properties": {
          "skills": {
            "$ref": "common.json#/definitions/skills"
          },
          "attributes": {
            "$ref": "common.json#/definitions/attributes"
          },
          "mana": {
            "type": "integer",
            "minimum": 0
          },
          "flags": {
            "type": "array",
            "items": {
              "$ref": "common.json#/definitions/key"
            }
          },
          "armor": {
            "type": "string",
            "enum": [
              "none",
              "light",
              "medium",
              "heavy"
            ]
          },
          "reagents": {
            "type": "array",
            "items": {
              "$ref": "common.json#/definitions/ref"
            }
          },
          "concentration": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "common.json#/definitions/key"
              }
            ]
          },
          "summons": {
            "type": "array",
            "items": {
              "$ref": "common.json#/definitions/ref"
            },
            "description": "The caster's active summons, oldest first: one summon group ref per creature (docs/core/casting.md#summons)."
          },
          "minions": {
            "type": "array",
            "items": {
              "$ref": "common.json#/definitions/ref"
            },
            "description": "The caster's minions, oldest first: one summon group ref per creature, outside the summon limit (docs/core/casting.md#minions)."
          },
          "summon_templates": {
            "type": "array",
            "items": {
              "$ref": "common.json#/definitions/ref"
            },
            "description": "The element templates of the caster's active summons (core:monster_template/<key>), which Elemental Kinship reads (docs/core/casting.md#the-bonded-summoner)."
          },
          "perks": {
            "type": "array",
            "items": {
              "$ref": "common.json#/definitions/ref"
            },
            "description": "The caster's perks (core:feature/<key>): a bound weapon reads the material each unlocks (the highest perk's wins; order does not matter) and their bound_weapon_effects (docs/core/casting.md#bound-weapons)."
          }
        },
        "required": [
          "skills",
          "mana"
        ],
        "additionalProperties": false
      },
      "modifiers": {
        "$ref": "common.json#/definitions/modifiers"
      },
      "roll": {
        "$ref": "common.json#/definitions/d100"
      },
      "count_roll": {
        "type": "integer",
        "minimum": 0,
        "description": "The rolled total of a minion spell's count dice (docs/core/casting.md#minions)."
      },
      "coating": {
        "$ref": "common.json#/definitions/ref",
        "description": "A coating on the conjured weapon: a core:effect/damage_<type> with the coating channel."
      },
      "enchantment": {
        "$ref": "common.json#/definitions/ref",
        "description": "An elemental enchantment on the conjured weapon: a core:effect/damage_<type> with the enchantment channel; it wins over a coating."
      },
      "standing": {
        "type": "array",
        "items": {
          "$ref": "common.json#/definitions/key"
        },
        "description": "Spell keys standing on the target, for dispel."
      },
      "target": {
        "type": "object",
        "description": "The defender: its save against an instant spell (attributes, skills, roll), and, when it has hp, what the cast's damage does to it through combat steps 2 to 8 (docs/core/casting.md#damage-to-a-target).",
        "properties": {
          "attributes": {
            "$ref": "common.json#/definitions/attributes"
          },
          "skills": {
            "$ref": "common.json#/definitions/skills"
          },
          "roll": {
            "$ref": "common.json#/definitions/d100",
            "description": "The save roll; an instant spell needs it."
          },
          "hp": {
            "type": "integer",
            "minimum": 0
          },
          "armor_dr": {
            "type": "integer",
            "minimum": 0
          },
          "resist": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "propertyNames": {
              "pattern": "^[a-z_][a-z0-9_]*$"
            }
          },
          "evasion_skill": {
            "type": "integer"
          },
          "shield_dr": {"type": "integer", "minimum": 0, "description": "The carried shield's DR; it adds to armor_dr against types with armor_dr_applies."},
          "shields_skill": {"type": "integer", "description": "The shields skill the block stance's band reads."},
          "stance": {"type": "string", "description": "The stance the defender declared on their turn: dodge (doubles the evasion band) or block (adds a block band; needs shield_dr and shields_skill). Any other value is an error."},
          "flags": {
            "type": "array",
            "items": {
              "$ref": "common.json#/definitions/key"
            },
            "description": "Flags from conditions (prone, blinded, invisible); a situation row with `when` reads them."
          },
          "modifiers": {
            "$ref": "common.json#/definitions/modifiers"
          }
        },
        "additionalProperties": false
      }
    },
    "required": [
      "spell",
      "caster",
      "roll"
    ],
    "additionalProperties": false
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "outcome": {
        "type": "string",
        "enum": [
          "cast",
          "failed",
          "prevented",
          "no_mana",
          "no_reagents"
        ]
      },
      "mana": {
        "type": "integer",
        "minimum": 0
      },
      "consumed": {
        "type": "array",
        "items": {
          "$ref": "common.json#/definitions/ref"
        }
      },
      "check": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "properties": {
              "target": {
                "type": "integer"
              },
              "success": {
                "type": "boolean"
              },
              "margin": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "tags": {
                "$ref": "common.json#/definitions/tags"
              }
            },
            "required": [
              "target",
              "success",
              "margin",
              "tags"
            ],
            "additionalProperties": false
          }
        ]
      },
      "effects": {
        "type": "array",
        "items": {
          "$ref": "../../ruleset/schemas/schema.json#/definitions/appliedEffect"
        }
      },
      "concentration": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "common.json#/definitions/key"
          }
        ]
      },
      "ended": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "common.json#/definitions/key"
          }
        ]
      },
      "dispelled": {
        "type": "array",
        "items": {
          "$ref": "common.json#/definitions/key"
        }
      },
      "save": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "properties": {
              "target": {
                "type": "integer"
              },
              "success": {
                "type": "boolean"
              },
              "margin": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "tags": {
                "$ref": "common.json#/definitions/tags"
              },
              "result": {
                "type": "string",
                "enum": [
                  "failed",
                  "partial",
                  "full"
                ]
              }
            },
            "required": [
              "target",
              "success",
              "margin",
              "tags",
              "result"
            ],
            "additionalProperties": false
          }
        ]
      },
      "summons": {
        "type": "array",
        "items": {
          "$ref": "common.json#/definitions/ref"
        },
        "description": "The active summons after the cast, oldest first."
      },
      "dismissed": {
        "type": "array",
        "items": {
          "$ref": "common.json#/definitions/ref"
        },
        "description": "The summons the cast dismissed to stay within the limit, oldest first."
      },
      "minions": {
        "type": "array",
        "items": {
          "$ref": "common.json#/definitions/ref"
        },
        "description": "The caster's minions after the cast, oldest first."
      },
      "damage": {
        "type": "array",
        "description": "Per damage packet, when target has hp: the combat steps' outcome.",
        "items": {
          "type": "object",
          "properties": {
            "effect": {
              "$ref": "common.json#/definitions/ref"
            },
            "type": {
              "type": "string"
            },
            "amount": {
              "type": "integer",
              "description": "The packet before the combat steps."
            },
            "damage": {
              "type": "integer",
              "description": "HP lost."
            },
            "evaded": {
              "type": "boolean"
            },
            "blocked": {
              "type": "boolean"
            }
          },
          "required": [
            "effect",
            "type",
            "amount",
            "damage",
            "evaded",
            "blocked"
          ],
          "additionalProperties": false
        }
      },
      "bound_weapon": {
        "type": "object",
        "description": "The conjured weapon, when the spell has a bound_weapon effect (docs/core/casting.md#bound-weapons); left out otherwise.",
        "properties": {
          "weapon": {
            "$ref": "common.json#/definitions/ref"
          },
          "skill": {
            "$ref": "common.json#/definitions/key"
          },
          "dice": {
            "type": "string"
          },
          "material": {
            "$ref": "common.json#/definitions/ref"
          },
          "attack": {
            "type": "integer"
          },
          "damage_type": {
            "$ref": "common.json#/definitions/key"
          },
          "phase": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "common.json#/definitions/phase"
              }
            ]
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "weapon",
          "skill",
          "dice",
          "material",
          "attack",
          "damage_type",
          "phase",
          "effects"
        ],
        "additionalProperties": false
      },
      "hp": {
        "type": [
          "integer",
          "null"
        ],
        "description": "The target's HP after every packet; null without a target hp."
      }
    },
    "additionalProperties": false
  }
}
