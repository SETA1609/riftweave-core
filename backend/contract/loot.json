{
  "$schema": "./command.schema.json",
  "name": "loot",
  "summary": "Roll a loot table by key, or a monster's loot rows, with the looter's Luck and modifiers, and value it on the price scale.",
  "documentation": "docs/core/loot.md",
  "input_schema": {
    "type": "object",
    "properties": {
      "table": {
        "$ref": "common.json#/definitions/key"
      },
      "monster": {
        "$ref": "common.json#/definitions/ref"
      },
      "rolls": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer"
        }
      },
      "actor": {
        "$ref": "common.json#/definitions/actor",
        "description": "The looter; attributes.lck emits the Luck shift."
      },
      "modifiers": {
        "$ref": "common.json#/definitions/modifiers",
        "description": "The looter's modifiers; those on loot_roll add to the looter shift."
      }
    },
    "additionalProperties": false,
    "required": [
      "rolls"
    ],
    "oneOf": [
      {
        "required": [
          "table"
        ]
      },
      {
        "required": [
          "monster"
        ]
      }
    ]
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "table": {
        "$ref": "common.json#/definitions/key"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "item": {
              "$ref": "common.json#/definitions/ref"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            },
            "material": {
              "$ref": "common.json#/definitions/ref"
            },
            "size": {
              "type": "string",
              "enum": [
                "undersized",
                "oversized"
              ]
            },
            "dice": {
              "type": "string",
              "description": "A sized weapon's dice after the size step."
            },
            "attack": {
              "type": "integer",
              "description": "A sized weapon's attack change."
            }
          },
          "additionalProperties": false,
          "required": [
            "item",
            "quantity"
          ]
        }
      },
      "coins_cp": {
        "type": "integer",
        "minimum": 0
      },
      "value_cp": {
        "type": "integer",
        "minimum": 0
      },
      "budget_cp": {
        "type": "integer",
        "minimum": 0
      },
      "tables": {
        "type": "array",
        "items": {
          "$ref": "common.json#/definitions/key"
        },
        "description": "For a monster: the tables it rolled, in row order."
      },
      "looter_shift": {
        "type": "integer",
        "description": "Luck plus the looter's loot_roll modifiers, after kernel stacking; 0 with no looter."
      }
    },
    "additionalProperties": false,
    "required": [
      "items",
      "coins_cp",
      "value_cp",
      "budget_cp"
    ]
  }
}
