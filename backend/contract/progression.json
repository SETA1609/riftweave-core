{
  "$schema": "./command.schema.json",
  "name": "progression",
  "summary": "XP and level, a level-up pool, spending points on a skill or a skill group, and reading a skill off a sheet.",
  "documentation": "docs/core/progression.md",
  "input_schema": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "xp",
          "level",
          "level_up",
          "spend",
          "read_skill"
        ]
      },
      "level": {
        "type": "integer",
        "minimum": 1
      },
      "xp": {
        "type": "integer",
        "minimum": 0
      },
      "actor": {
        "$ref": "common.json#/definitions/actor"
      },
      "luck_roll": {
        "type": "integer"
      },
      "hp_roll": {
        "type": "integer"
      },
      "mp_roll": {
        "type": "integer"
      },
      "sp_roll": {
        "type": "integer"
      },
      "skill": {
        "type": "integer"
      },
      "tagged": {
        "type": "boolean"
      },
      "points": {
        "type": "integer",
        "minimum": 0
      },
      "group": {
        "type": "string",
        "description": "With spend: a skill group key (skill_groups/core.json); one rank costs the group cost, and `skill` is the highest member's value."
      },
      "read": {
        "type": "string",
        "description": "With read_skill: the skill key to read."
      },
      "groups": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        },
        "description": "With read_skill: a grouped sheet, the ranks of each tracked group by key. Without it the sheet is a full one and reads actor.skills."
      }
    },
    "additionalProperties": false,
    "required": [
      "operation"
    ]
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "xp_total": {
        "type": "integer"
      },
      "xp_step": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "level": {
        "type": "integer"
      },
      "skill_points": {
        "type": "integer"
      },
      "perks": {
        "type": "integer"
      },
      "gain": {
        "type": "object",
        "properties": {
          "hp": {
            "type": "integer"
          },
          "mp": {
            "type": "integer"
          },
          "sp": {
            "type": "integer"
          }
        },
        "required": [
          "hp",
          "mp",
          "sp"
        ],
        "additionalProperties": false
      },
      "ranks": {
        "type": "integer"
      },
      "spent": {
        "type": "integer"
      },
      "left": {
        "type": "integer"
      },
      "value": {
        "type": "integer"
      },
      "read_from": {
        "type": "string",
        "enum": [
          "sheet",
          "group",
          "start"
        ]
      }
    },
    "additionalProperties": false,
    "minProperties": 1
  }
}
