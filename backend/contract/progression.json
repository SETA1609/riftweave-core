{
  "$schema": "./command.schema.json",
  "name": "progression",
  "summary": "XP and level, a level-up pool, spending points on a skill or a skill group, reading a skill off a sheet, and taking a perk.",
  "documentation": "docs/core/progression.md",
  "input_schema": {
    "type": "object",
    "properties": {
      "operation": {
        "type": "string",
        "enum": [
          "xp",
          "level",
          "level_up",
          "spend",
          "read_skill",
          "take_perk"
        ]
      },
      "level": {
        "type": "integer",
        "minimum": 1
      },
      "xp": {
        "type": "integer",
        "minimum": 0
      },
      "actor": {
        "$ref": "common.json#/definitions/actor"
      },
      "luck_roll": {
        "type": "integer"
      },
      "hp_roll": {
        "type": "integer"
      },
      "mp_roll": {
        "type": "integer"
      },
      "sp_roll": {
        "type": "integer"
      },
      "skill": {
        "type": "integer"
      },
      "tagged": {
        "type": "boolean"
      },
      "points": {
        "type": "integer",
        "minimum": 0
      },
      "group": {
        "type": "string",
        "description": "With spend: a skill group key (skill_groups/core.json); one rank costs the group cost, and `skill` is the highest member's value."
      },
      "read": {
        "type": "string",
        "description": "With read_skill: the skill key to read."
      },
      "groups": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "minimum": 0
        },
        "description": "With read_skill: a grouped sheet, the ranks of each tracked group by key. Without it the sheet is a full one and reads actor.skills."
      },
      "key": {
        "$ref": "common.json#/definitions/key",
        "description": "With spend: the skill bought. The command does not read it; a session fills `skill` and `tagged` from this skill and adds the ranks to it (docs/backend/sessions.md)."
      },
      "perks": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "minimum": 1
        },
        "description": "With take_perk: the perks held, key to rank."
      },
      "perk": {
        "$ref": "common.json#/definitions/key",
        "description": "With take_perk: the perk to take, a key in features/core.json."
      }
    },
    "additionalProperties": false,
    "required": [
      "operation"
    ]
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "xp_total": {
        "type": "integer"
      },
      "xp_step": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ]
      },
      "level": {
        "type": "integer"
      },
      "skill_points": {
        "type": "integer"
      },
      "perks": {
        "type": "integer"
      },
      "gain": {
        "type": "object",
        "properties": {
          "hp": {
            "type": "integer"
          },
          "mp": {
            "type": "integer"
          },
          "sp": {
            "type": "integer"
          }
        },
        "required": [
          "hp",
          "mp",
          "sp"
        ],
        "additionalProperties": false
      },
      "ranks": {
        "type": "integer"
      },
      "spent": {
        "type": "integer"
      },
      "left": {
        "type": "integer"
      },
      "value": {
        "type": "integer"
      },
      "read_from": {
        "type": "string",
        "enum": [
          "sheet",
          "group",
          "start"
        ]
      },
      "taken": {
        "type": "boolean"
      },
      "perk": {
        "type": "string",
        "description": "With take_perk: the perk checked."
      },
      "rank": {
        "type": "integer",
        "minimum": 0,
        "description": "With take_perk: the new rank when taken, else the rank held (0 when not held)."
      },
      "unmet": {
        "type": "array",
        "description": "With take_perk: each requirement that fails, empty when taken.",
        "items": {
          "type": "object",
          "properties": {
            "needs": {
              "type": "string",
              "enum": [
                "rank",
                "level",
                "attribute",
                "skill",
                "perk"
              ]
            },
            "key": {
              "type": "string",
              "description": "The attribute or perk key."
            },
            "keys": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "The skills of a skill requirement; one of them must reach min."
            },
            "min": {
              "type": "integer"
            },
            "max": {
              "type": "integer",
              "description": "A rank requirement: the perk's ranks."
            },
            "has": {
              "type": "integer"
            }
          },
          "required": [
            "needs"
          ],
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false,
    "minProperties": 1
  }
}
