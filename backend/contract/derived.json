{
  "$schema": "./command.schema.json",
  "name": "derived",
  "summary": "HP, MP, SP, AP, carry, initiative, and the toxicity limit from attributes, level, and modifiers.",
  "documentation": "docs/core/derived.md",
  "input_schema": {
    "type": "object",
    "properties": {
      "actor": {
        "$ref": "common.json#/definitions/actor"
      },
      "modifiers": {
        "$ref": "common.json#/definitions/modifiers"
      },
      "templates": {
        "type": "array",
        "items": { "$ref": "common.json#/definitions/held_template" },
        "description": "The actor's held character templates: their attributes add first, and their modifiers and granted perks join modifiers; two in one slot are refused (docs/core/templates.md)."
      }
    },
    "additionalProperties": false,
    "required": [
      "actor"
    ]
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "hp": {
        "type": "integer"
      },
      "mp": {
        "type": "integer"
      },
      "sp": {
        "type": "integer"
      },
      "ap": {
        "type": "integer"
      },
      "carry": {
        "type": "integer"
      },
      "initiative": {
        "type": "integer"
      },
      "toxicity_limit": {
        "type": "integer"
      }
    },
    "additionalProperties": false,
    "required": [
      "hp",
      "mp",
      "sp",
      "ap",
      "carry",
      "initiative",
      "toxicity_limit"
    ]
  }
}
