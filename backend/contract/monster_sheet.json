{
  "$schema": "./command.schema.json",
  "name": "monster_sheet",
  "summary": "A monster's derived stats and the skills asked for, by the same rules as a player.",
  "documentation": "docs/core/actor-sheet.md",
  "input_schema": {
    "type": "object",
    "properties": {
      "monster": {
        "type": "object",
        "properties": {
          "attributes": {
            "$ref": "common.json#/definitions/attributes"
          },
          "skills": {
            "$ref": "common.json#/definitions/skills"
          },
          "level": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "type": "string",
            "enum": ["standard", "boss", "minion"],
            "description": "Scales the computed HP by progression/core.json monster_hp_multiplier; default standard (DE_S02_03)."
          },
          "perks": {
            "type": "array",
            "description": "The row's perks, each at a rank (M3-15); their modifiers reach the stats and skills.",
            "items": {
              "type": "object",
              "properties": {
                "perk": {
                  "$ref": "common.json#/definitions/ref"
                },
                "rank": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "perk"
              ],
              "additionalProperties": false
            }
          },
          "maneuvers": {
            "type": "array",
            "items": {
              "$ref": "common.json#/definitions/ref"
            },
            "description": "The maneuvers the row lists (M3-24)."
          }
        }
      },
      "read_skills": {
        "type": "array",
        "items": {
          "$ref": "common.json#/definitions/key"
        }
      }
    },
    "additionalProperties": false,
    "required": [
      "monster"
    ]
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "hp": {
        "type": "integer"
      },
      "mp": {
        "type": "integer"
      },
      "sp": {
        "type": "integer"
      },
      "ap": {
        "type": "integer"
      },
      "carry": {
        "type": "integer"
      },
      "initiative": {
        "type": "integer"
      },
      "skills": {
        "type": "object",
        "additionalProperties": {
          "type": "integer"
        }
      },
      "maneuvers": {
        "type": "array",
        "items": {
          "$ref": "common.json#/definitions/ref"
        },
        "description": "The maneuvers the monster can use: the ones it lists and the ones its perks unlock, sorted (GD_S05_04)."
      },
      "riders": {
        "type": "array",
        "items": {
          "$ref": "common.json#/definitions/ref"
        },
        "description": "The maneuvers its held rider perks put on its plain attacks that fit them, sorted; left out without one. Two perks that exclude each other are an error."
      }
    },
    "required": [
      "hp",
      "mp",
      "sp",
      "ap",
      "carry",
      "initiative",
      "skills"
    ]
  }
}
