{
  "$schema": "./command.schema.json",
  "name": "stored_actor",
  "summary": "Check a stored actor and return it unchanged, so a save round-trips; or make a new one from attributes, with its pools full.",
  "documentation": "docs/core/state.md",
  "input_schema": {
    "type": "object",
    "properties": {
      "actor": {
        "$ref": "common.json#/definitions/stored_actor"
      },
      "new": {
        "type": "object",
        "description": "Make a new stored actor: that level (default 1), xp 0, nothing else held, and every pool full at the maximum derived gives (docs/core/state.md#the-stored-actor).",
        "properties": {
          "attributes": { "$ref": "common.json#/definitions/attributes" },
          "level": { "type": "integer", "minimum": 1 },
          "tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.json#/definitions/key" } }
        },
        "required": ["attributes"],
        "additionalProperties": false
      }
    },
    "oneOf": [
      { "required": ["actor"] },
      { "required": ["new"] }
    ],
    "additionalProperties": false
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "actor": {
        "$ref": "common.json#/definitions/stored_actor"
      }
    },
    "required": [
      "actor"
    ],
    "additionalProperties": false
  }
}
