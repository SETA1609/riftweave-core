{
  "$schema": "./command.schema.json",
  "name": "author",
  "summary": "Author content rows: check a draft spell as validate.py would, give the spellcraft cost, load a spell to edit, list the effects a color may use, and export a core or module data file.",
  "documentation": "docs/backend/authoring.md",
  "input_schema": {
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "spell"
        ]
      },
      "operation": {
        "type": "string",
        "enum": [
          "check",
          "load",
          "effects"
        ],
        "description": "check (the default) a list of drafts, load one spell by key, or list the effects a spell of a color may use."
      },
      "spells": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object"
        },
        "description": "check: the draft rows, as spells/core.json holds them; the schema is checked by the command, so a draft may be wrong."
      },
      "spell": {
        "$ref": "common.json#/definitions/key",
        "description": "load: the spell to load."
      },
      "color": {
        "type": "string",
        "description": "effects: the spell's color; the pool is the effects on that color or on none that list the spell channel (BE_S09_01)."
      },
      "export": {
        "type": "object",
        "properties": {
          "shape": {
            "type": "string",
            "enum": [
              "core",
              "module"
            ]
          },
          "module": {
            "$ref": "common.json#/definitions/key",
            "description": "shape module: the module's id."
          }
        },
        "required": [
          "shape"
        ],
        "additionalProperties": false,
        "if": {
          "properties": {
            "shape": {
              "const": "module"
            }
          }
        },
        "then": {
          "required": [
            "module"
          ]
        }
      }
    },
    "required": [
      "kind"
    ],
    "additionalProperties": false
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "spells": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "row": {
              "type": "object",
              "description": "The draft as the file will hold it."
            },
            "problems": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "check": {
                    "type": "string",
                    "enum": [
                      "schema",
                      "ref",
                      "channel",
                      "parameter",
                      "cost"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "description": "A JSON pointer into the row."
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "check",
                  "path",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "check": {
                    "type": "string",
                    "enum": [
                      "schema",
                      "ref",
                      "channel",
                      "parameter",
                      "cost"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "description": "A JSON pointer into the row."
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "check",
                  "path",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "cost": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "mana": {
                  "type": "integer"
                },
                "cast_threshold": {
                  "type": "integer"
                },
                "craft_threshold": {
                  "type": "integer"
                }
              },
              "required": [
                "mana",
                "cast_threshold",
                "craft_threshold"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "key",
            "row",
            "problems",
            "warnings",
            "cost"
          ],
          "additionalProperties": false
        }
      },
      "effects": {
        "type": "array",
        "description": "effects: the pool, in file order, each with its row as effects/core.json writes it.",
        "items": {
          "type": "object",
          "properties": {
            "ref": {
              "$ref": "common.json#/definitions/ref"
            },
            "row": {
              "type": "object"
            }
          },
          "required": [
            "ref",
            "row"
          ],
          "additionalProperties": false
        }
      },
      "export": {
        "type": "object",
        "properties": {
          "shape": {
            "type": "string",
            "enum": [
              "core",
              "module"
            ]
          },
          "path": {
            "type": "string",
            "description": "Where the file goes, from the repository root."
          },
          "file": {
            "type": "object",
            "description": "The whole data file: $schema and the spells wrapper."
          },
          "manifest": {
            "type": "object",
            "description": "shape module: the manifest the module needs."
          },
          "refs": {
            "type": "array",
            "items": {
              "$ref": "common.json#/definitions/ref"
            },
            "description": "How other rows name each exported spell."
          }
        },
        "required": [
          "shape",
          "path",
          "file",
          "refs"
        ],
        "additionalProperties": false
      },
      "row": {
        "type": "object",
        "description": "load: the spell as written."
      }
    },
    "additionalProperties": false
  }
}
