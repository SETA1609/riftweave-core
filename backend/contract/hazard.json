{
  "$schema": "./command.schema.json",
  "name": "hazard",
  "summary": "Detect, disarm, or trigger a hazard, or apply a cast spell to it: the checks go through the resolution function; a trigger emits a packet and effects; a spell may disarm it.",
  "documentation": "docs/core/hazards.md",
  "input_schema": {
    "type": "object",
    "properties": {
      "hazard": {
        "$ref": "common.json#/definitions/key"
      },
      "operation": {
        "type": "string",
        "enum": [
          "detect",
          "disarm",
          "trigger",
          "spell"
        ]
      },
      "spell": {
        "$ref": "common.json#/definitions/key",
        "description": "op spell: the spell that was cast on the hazard."
      },
      "actor": {
        "$ref": "common.json#/definitions/actor"
      },
      "modifiers": {
        "$ref": "common.json#/definitions/modifiers"
      },
      "roll": {
        "$ref": "common.json#/definitions/d100"
      },
      "damage_roll": {
        "type": "integer",
        "minimum": 0
      }
    },
    "additionalProperties": false,
    "required": [
      "hazard",
      "operation"
    ]
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "success": {
        "type": "boolean"
      },
      "target": {
        "type": "integer"
      },
      "margin": {
        "type": [
          "integer",
          "null"
        ]
      },
      "tags": {
        "$ref": "common.json#/definitions/tags"
      },
      "triggered": {
        "type": "boolean"
      },
      "avoided": {
        "type": "boolean"
      },
      "packet": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "properties": {
              "amount": {
                "type": "integer",
                "minimum": 0
              },
              "type": {
                "$ref": "common.json#/definitions/key"
              }
            },
            "required": [
              "amount",
              "type"
            ],
            "additionalProperties": false
          }
        ]
      },
      "effects": {
        "type": "array",
        "items": {
          "$ref": "common.json#/definitions/ref"
        }
      },
      "disarmed": {
        "type": "boolean"
      },
      "effect": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "$ref": "common.json#/definitions/ref"
          }
        ]
      }
    },
    "additionalProperties": false
  }
}
