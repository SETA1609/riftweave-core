{
  "$schema": "./command.schema.json",
  "name": "consume",
  "summary": "Use items and let time pass: instant and over-time effects, and food replacing food.",
  "doc": "docs/core/modifier.md",
  "input_schema": {
    "type": "object",
    "properties": {
      "current": {
        "type": "object",
        "properties": {
          "hp": {
            "type": "integer",
            "minimum": 0
          },
          "mp": {
            "type": "integer",
            "minimum": 0
          },
          "stamina": {
            "type": "integer",
            "minimum": 0
          },
          "toxicity": {
            "type": "integer",
            "minimum": 0,
            "description": "Stored toxicity; missing reads 0 (docs/core/modifier.md#toxicity)."
          },
          "ap": {
            "type": "integer",
            "minimum": 0,
            "description": "AP in the pool, read with at_table (docs/core/actions.md#one-rule-set-two-clocks)."
          }
        },
        "additionalProperties": false
      },
      "max": {
        "type": "object",
        "properties": {
          "hp": {
            "type": "integer",
            "minimum": 0
          },
          "mp": {
            "type": "integer",
            "minimum": 0
          },
          "stamina": {
            "type": "integer",
            "minimum": 0
          },
          "toxicity": {
            "type": "integer",
            "minimum": 0,
            "description": "The toxicity limit, the derived toxicity_limit."
          }
        },
        "additionalProperties": false
      },
      "events": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "item": {
              "$ref": "common.json#/definitions/key",
              "description": "A consumable key."
            },
            "in_combat": {
              "type": "boolean"
            },
            "advance": {
              "type": "integer",
              "minimum": 0,
              "description": "Seconds that pass."
            },
            "turns": {
              "type": "integer",
              "minimum": 0,
              "description": "Turns that pass, each seconds_per_turn long."
            }
          },
          "additionalProperties": false
        }
      },
      "at_table": {
        "type": "boolean",
        "description": "At a table a stamina restore becomes AP, stamina_per_ap to the point, that arrives at the start of the next turn and stops at the pool cap."
      }
    },
    "additionalProperties": false,
    "required": [
      "current",
      "max",
      "events"
    ]
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "hp": {
        "type": "integer"
      },
      "mp": {
        "type": "integer"
      },
      "stamina": {
        "type": "integer"
      },
      "ticks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "origin": {
              "type": "string"
            },
            "pool": {
              "type": "string"
            },
            "magnitude": {
              "type": "integer"
            },
            "seconds_left": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      },
      "modifiers": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "origin": {
              "type": "string"
            },
            "target": {
              "type": "string"
            },
            "op": {
              "type": "string"
            },
            "value": {
              "type": "integer"
            },
            "seconds_left": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      },
      "refused": {
        "type": "array",
        "items": {
          "$ref": "common.json#/definitions/key"
        }
      },
      "toxicity": {
        "type": "integer",
        "minimum": 0
      },
      "conditions": {
        "type": "array",
        "items": {
          "$ref": "common.json#/definitions/ref"
        },
        "description": "core:condition/overdosed while toxicity is above max.toxicity."
      },
      "ap": {
        "type": "integer",
        "minimum": 0,
        "description": "AP in the pool, with at_table."
      },
      "pending_ap": {
        "type": "integer",
        "minimum": 0,
        "description": "AP restored this turn, arriving at the start of the next, with at_table."
      }
    },
    "additionalProperties": false,
    "required": [
      "hp",
      "mp",
      "stamina",
      "ticks",
      "modifiers",
      "refused"
    ]
  }
}
