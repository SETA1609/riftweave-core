{
  "$schema": "./command.schema.json",
  "name": "formula",
  "summary": "Evaluate a formula tree, by key or inline.",
  "doc": "docs/core/formula.md",
  "input_schema": {
    "type": "object",
    "properties": {
      "formula": {
        "$ref": "common.json#/definitions/key"
      },
      "expr": {
        "$ref": "../../ruleset/schemas/schema.json#/definitions/formulaNode"
      },
      "actor": {
        "$ref": "common.json#/definitions/actor"
      },
      "variables": {
        "type": "object",
        "description": "Named inputs of the formula, such as instant_cost (formulas/toxicity.json).",
        "additionalProperties": {
          "type": "integer"
        }
      },
      "expression": {
        "$ref": "../../ruleset/schemas/schema.json#/definitions/formulaNode"
      }
    },
    "additionalProperties": false,
    "oneOf": [
      {
        "required": [
          "formula"
        ]
      },
      {
        "required": [
          "expr"
        ]
      },
      {
        "required": [
          "expression"
        ]
      }
    ]
  },
  "result_schema": {
    "type": "object",
    "properties": {
      "value": {
        "type": "integer"
      }
    },
    "additionalProperties": false,
    "required": [
      "value"
    ]
  }
}
