{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ammunition recovery",
  "description": "The share of each kind of round recovered after a fight, rounded down, and of thrown weapons (docs/core/combat.md#ammunition). Perks change it (GD_S17_10).",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "recovery": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "anyOf": [
              {
                "$ref": "schema.json#/definitions/ammoKind"
              },
              {
                "const": "thrown",
                "description": "A thrown weapon, its own ammunition."
              }
            ]
          },
          "recovered": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "kind",
          "recovered"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "recovery"
  ],
  "additionalProperties": false
}
