{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Derived stats",
  "description": "Coefficients for stats recomputed from the actor snapshot. A module may emit a modifier on the result. It may not store a second max.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "derived": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/derivedStat" }
    }
  },
  "required": ["derived"],
  "additionalProperties": false,
  "definitions": {
    "derivedStat": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "label": { "type": "string" },
        "attr": {
          "type": "string",
          "enum": ["str", "per", "end", "int", "wil", "agi", "cha", "lck"]
        },
        "attribute": {
          "type": "string",
          "enum": ["str", "per", "end", "int", "wil", "agi", "cha", "lck"],
          "description": "The attribute the stat reads (M5-46; was attr)."
        },
        "base": { "type": "number" },
        "per_point": { "type": "number" },
        "per_point_divisor": {
          "type": "integer",
          "minimum": 1,
          "description": "Divide attribute * per_point by this, integer division, before adding. Default 1. Action points use 3."
        },
        "per_level_attr": { "type": "number" },
        "per_level_attribute": { "type": "number", "description": "Per level, this times the attribute is added (M5-46; was per_level_attr)." },
        "per_level_flat": { "type": "number" },
        "unit": { "type": "string" }
      },
      "required": ["key", "label", "base", "per_point", "per_level_flat"],
      "allOf": [
        { "anyOf": [{ "required": ["attribute"] }, { "required": ["attr"] }] },
        { "anyOf": [{ "required": ["per_level_attribute"] }, { "required": ["per_level_attr"] }] }
      ],
      "additionalProperties": false
    }
  }
}
