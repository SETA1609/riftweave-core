{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Casting",
  "description": "The coefficients of the cast procedure (docs/core/casting.md): the caster flags that block a cast, and the cast penalty of the heaviest armor category worn.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "casting": {
      "type": "object",
      "properties": {
        "prevented_by": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
          "uniqueItems": true,
          "description": "Caster flags (granted by conditions) that block every cast; nothing is spent."
        },
        "armor_penalty": {
          "type": "object",
          "description": "An add on the cast target by the heaviest armor category worn; `none` is no armor.",
          "properties": {
            "none": { "type": "integer", "maximum": 0 },
            "light": { "type": "integer", "maximum": 0 },
            "medium": { "type": "integer", "maximum": 0 },
            "heavy": { "type": "integer", "maximum": 0 }
          },
          "required": ["none", "light", "medium", "heavy"],
          "additionalProperties": false
        },
        "save": {
          "type": "object",
          "description": "How an instant spell's save picks its outcome (docs/core/casting.md#delivery-and-saves).",
          "properties": {
            "attribute_multiplier": { "type": "integer", "minimum": 1 },
            "full_margin": { "type": "integer", "minimum": 0 },
            "partial_percent": { "type": "integer", "minimum": 1, "maximum": 100 }
          },
          "required": ["attribute_multiplier", "full_margin", "partial_percent"],
          "additionalProperties": false
        },
        "skill_discount": {
          "type": "object",
          "description": "What skill takes off a spell's mana cost: min(skill / divisor, cap), and the least a cast can cost (docs/core/casting.md#paid-cost).",
          "properties": {
            "divisor": { "type": "number", "exclusiveMinimum": 0 },
            "cap": { "type": "number", "minimum": 0, "maximum": 1 },
            "minimum_paid": { "type": "integer", "minimum": 0 }
          },
          "required": ["divisor", "cap", "minimum_paid"],
          "additionalProperties": false
        },
        "spell_cost": {
          "type": "object",
          "description": "The spell cost formula's coefficients (docs/modules/magic.md#cost-formula): per effect, magnitude_factor × baseCost × magnitude × duration, plus area_factor × baseCost × radius, times the target multiplier; the spell cost is the sum, rounded up.",
          "properties": {
            "magnitude_factor": { "type": "number", "exclusiveMinimum": 0 },
            "area_factor": { "type": "number", "minimum": 0 },
            "target_multiplier": {
              "type": "object",
              "properties": {
                "self": { "type": "number", "exclusiveMinimum": 0 },
                "touch": { "type": "number", "exclusiveMinimum": 0 },
                "ranged": { "type": "number", "exclusiveMinimum": 0 },
                "area": { "type": "number", "exclusiveMinimum": 0 },
                "world": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["self", "touch", "ranged", "area"],
              "additionalProperties": false
            }
          },
          "required": ["magnitude_factor", "area_factor", "target_multiplier"],
          "additionalProperties": false
        },
        "research": {
          "type": "object",
          "description": "The Research downtime action: what one attempt to learn an effect takes, spent whatever the roll (docs/modules/magic.md#spell-knowledge).",
          "properties": {
            "days": { "type": "integer", "minimum": 1 },
            "cost": {
              "type": "object",
              "properties": {
                "quantity": { "type": "integer", "minimum": 0 },
                "unit": { "type": "string", "enum": ["cp", "sp", "gp", "pp"] }
              },
              "required": ["quantity", "unit"],
              "additionalProperties": false
            }
          },
          "required": ["days", "cost"],
          "additionalProperties": false
        }
      },
      "required": ["prevented_by", "armor_penalty", "skill_discount", "spell_cost"],
      "additionalProperties": false
    }
  },
  "required": ["casting"],
  "additionalProperties": false
}
