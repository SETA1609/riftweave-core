{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Casting",
  "description": "The coefficients of the cast procedure (docs/core/casting.md): the caster flags that block a cast, and the cast penalty of the heaviest armor category worn.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "casting": {
      "type": "object",
      "properties": {
        "prevented_by": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
          "uniqueItems": true,
          "description": "Caster flags (granted by conditions) that block every cast; nothing is spent."
        },
        "armor_penalty": {
          "type": "object",
          "description": "An add on the cast target by the heaviest armor category worn; `none` is no armor.",
          "properties": {
            "none": { "type": "integer", "maximum": 0 },
            "light": { "type": "integer", "maximum": 0 },
            "medium": { "type": "integer", "maximum": 0 },
            "heavy": { "type": "integer", "maximum": 0 }
          },
          "required": ["none", "light", "medium", "heavy"],
          "additionalProperties": false
        },
        "shield_penalty": {
          "type": "object",
          "description": "An add on the cast target by the shield held, on top of the armor penalty (GD_S05_03); `none` is no shield. Modifiers on armor_cast_penalty (Mailed Casting) multiply both.",
          "properties": {
            "none": { "type": "integer", "maximum": 0 },
            "buckler": { "type": "integer", "maximum": 0 },
            "standard": { "type": "integer", "maximum": 0 },
            "tower": { "type": "integer", "maximum": 0 }
          },
          "required": ["none", "buckler", "standard", "tower"],
          "additionalProperties": false
        },
        "save": {
          "type": "object",
          "description": "How an instant spell's save picks its outcome (docs/core/casting.md#delivery-and-saves).",
          "properties": {
            "attribute_multiplier": { "type": "integer", "minimum": 1 },
            "full_margin": { "type": "integer", "minimum": 0 },
            "partial_percent": { "type": "integer", "minimum": 1, "maximum": 100 }
          },
          "required": ["attribute_multiplier", "full_margin", "partial_percent"],
          "additionalProperties": false
        },
        "skill_discount": {
          "type": "object",
          "description": "What skill takes off a spell's mana cost: min(skill / divisor, cap), and the least a cast can cost (docs/core/casting.md#paid-cost).",
          "properties": {
            "divisor": { "type": "number", "exclusiveMinimum": 0 },
            "cap": { "type": "number", "minimum": 0, "maximum": 1 },
            "minimum_paid": { "type": "integer", "minimum": 0 }
          },
          "required": ["divisor", "cap", "minimum_paid"],
          "additionalProperties": false
        },
        "cast_ap": {
          "type": "object",
          "description": "A cast's AP by the spell's level (docs/core/actions.md#cast-ap-by-level): the first band whose up_to_level is at or above the level, the last band (no up_to_level) above them all; the actor's modifiers on `cast` apply, and the AP never falls below minimum.",
          "properties": {
            "bands": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "up_to_level": { "type": "integer", "minimum": 1 },
                  "ap": { "type": "integer", "minimum": 1 }
                },
                "required": ["ap"],
                "additionalProperties": false
              }
            },
            "minimum": { "type": "integer", "minimum": 1 }
          },
          "required": ["bands", "minimum"],
          "additionalProperties": false
        },
        "spell_cost": {
          "type": "object",
          "description": "The spell cost formula's coefficients (docs/modules/magic.md#cost-formula): per effect, magnitude_factor × base_cost × magnitude × duration, plus area_factor × base_cost × radius, times the target multiplier; the spell cost is the sum, rounded up.",
          "properties": {
            "magnitude_factor": { "type": "number", "exclusiveMinimum": 0 },
            "area_factor": { "type": "number", "minimum": 0 },
            "target_multiplier": {
              "type": "object",
              "properties": {
                "self": { "type": "number", "exclusiveMinimum": 0 },
                "touch": { "type": "number", "exclusiveMinimum": 0 },
                "ranged": { "type": "number", "exclusiveMinimum": 0 },
                "area": { "type": "number", "exclusiveMinimum": 0 },
                "world": { "type": "number", "exclusiveMinimum": 0 }
              },
              "required": ["self", "touch", "ranged", "area"],
              "additionalProperties": false
            }
          },
          "required": ["magnitude_factor", "area_factor", "target_multiplier"],
          "additionalProperties": false
        },
        "bound_weapon": {
          "type": "object",
          "description": "What a conjured weapon starts as (docs/modules/magic.md#bound-weapons): its material, for its stats only (a bound weapon has no phase), and the damage type it deals in place of its weapon's.",
          "properties": {
            "material": { "$ref": "schema.json#/definitions/materialRef" },
            "damage_type": { "type": "string", "pattern": "^[a-z_]+$", "description": "A combat/damage_types.json key." }
          },
          "required": ["material", "damage_type"],
          "additionalProperties": false
        },
        "summon_limit": { "type": "integer", "minimum": 1, "description": "Active summons a caster holds before perks raise it; past it, a new summon dismisses the oldest (docs/core/casting.md#summons)." },
        "research": {
          "type": "object",
          "description": "The Research downtime action: what one attempt to learn an effect takes, spent whatever the roll (docs/modules/magic.md#spell-knowledge).",
          "properties": {
            "days": { "type": "integer", "minimum": 1 },
            "cost": {
              "type": "object",
              "properties": {
                "quantity": { "type": "integer", "minimum": 0 },
                "unit": { "type": "string", "enum": ["copper", "silver", "gold", "platinum"] }
              },
              "required": ["quantity", "unit"],
              "additionalProperties": false
            }
          },
          "required": ["days", "cost"],
          "additionalProperties": false
        }
      },
      "required": ["prevented_by", "armor_penalty", "shield_penalty", "skill_discount", "spell_cost", "bound_weapon", "cast_ap"],
      "additionalProperties": false
    }
  },
  "required": ["casting"],
  "additionalProperties": false
}
