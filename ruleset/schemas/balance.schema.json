{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Balance bands",
  "description": "The guideline bands of docs/modules/combat.md §10 as data, and the checks a report runs against monsters and gear, each a warning or a gate (docs/core/balance.md).",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "tiers": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/tier" } },
    "weapon_dice": { "$ref": "#/definitions/band", "description": "Mean of a weapon's damage dice." },
    "hits_to_kill": {
      "type": "object",
      "properties": {
        "standard": { "$ref": "#/definitions/band" },
        "boss": { "$ref": "#/definitions/band" },
        "minion": { "$ref": "#/definitions/band" }
      },
      "required": ["standard", "boss", "minion"],
      "additionalProperties": false
    },
    "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/check" } },
    "accepted": { "type": "array", "items": { "$ref": "#/definitions/accepted" } }
  },
  "required": ["tiers", "weapon_dice", "hits_to_kill", "checks", "accepted"],
  "additionalProperties": false,
  "definitions": {
    "band": {
      "type": "array",
      "description": "[min, max], inclusive.",
      "items": { "type": "number", "minimum": 0 },
      "minItems": 2,
      "maxItems": 2
    },
    "tier": {
      "type": "object",
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "levels": { "$ref": "#/definitions/band" },
        "expected_damage": { "$ref": "#/definitions/band" },
        "worn_dr": {
          "type": "object",
          "properties": {
            "light": { "$ref": "#/definitions/band" },
            "medium": { "$ref": "#/definitions/band" },
            "heavy": { "$ref": "#/definitions/band" }
          },
          "required": ["light", "medium", "heavy"],
          "additionalProperties": false
        }
      },
      "required": ["key", "levels", "expected_damage", "worn_dr"],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "key": { "type": "string", "enum": ["weapon_dice", "armor_piece_dr", "worn_set_dr", "monster_damage", "monster_hits_to_kill"] },
        "mode": { "type": "string", "enum": ["warn", "gate"] },
        "description": { "type": "string", "minLength": 1 }
      },
      "required": ["key", "mode", "description"],
      "additionalProperties": false
    },
    "accepted": {
      "type": "object",
      "properties": {
        "check": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "subject": { "type": "string", "minLength": 1, "description": "The item, monster, or category the finding names." },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["check", "subject", "reason"],
      "additionalProperties": false
    }
  }
}
