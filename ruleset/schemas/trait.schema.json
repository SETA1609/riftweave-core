{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trait",
  "description": "DEPRECATED (M1-06): racial traits are features of type racial_trait in feature.schema.json. This schema is removed once data/traits is migrated.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "traits": {
      "type": "array",
      "items": { "$ref": "#/definitions/trait" }
    }
  },
  "required": ["traits"],
  "additionalProperties": false,
  "definitions": {
    "trait": {
      "type": "object",
      "properties": {
        "id": { "$ref": "schema.json#/definitions/entryId" },
        "key": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$", "description": "Stable symbolic identifier (snake_case)." },
        "label": { "type": "string", "description": "Human-readable name of the trait." },
        "description": { "type": "string" },
        "source": { "$ref": "schema.json#/definitions/sourceRef" }
      },
      "required": ["id", "key", "label", "description"],
      "additionalProperties": false
    }
  }
}
