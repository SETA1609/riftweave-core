{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ability",
  "description": "One of the eight core attributes (1-10 scale)",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "abilities": {
      "type": "array",
      "items": { "$ref": "#/definitions/ability" }
    }
  },
  "required": ["abilities"],
  "additionalProperties": false,
  "definitions": {
    "ability": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "enum": ["str", "per", "end", "int", "wil", "agi", "cha", "lck"] },
        "name": { "type": "string" },
        "abbreviation": { "type": "string", "minLength": 3, "maxLength": 3 },
        "description": { "type": "string" },
        "source": { "$ref": "schema.json#/definitions/sourceRef" }
      },
      "required": ["id", "name", "abbreviation", "description"],
      "additionalProperties": false
    }
  }
}
