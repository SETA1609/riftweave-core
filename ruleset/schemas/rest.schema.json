{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rest and recovery",
  "description": "What comes back on each occasion. Every resource in the actor snapshot has a row; 'none' is a rule, not an omission.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "rest": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/occasion" }
    },
    "toxicity_decay": {
      "type": "object",
      "description": "How fast stored toxicity falls between rests (docs/core/modifier.md#toxicity).",
      "properties": { "per_second": { "type": "integer", "minimum": 0 } },
      "required": ["per_second"],
      "additionalProperties": false
    }
  },
  "required": ["rest"],
  "additionalProperties": false,
  "definitions": {
    "occasion": {
      "type": "object",
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
        "label": { "type": "string" },
        "minutes": { "type": "integer", "minimum": 0, "description": "In-world time the occasion takes. 0 for an event such as the end of combat." },
        "recovery": {
          "type": "array",
          "minItems": 5,
          "items": { "$ref": "#/definitions/recovery" }
        }
      },
      "required": ["key", "label", "minutes", "recovery"],
      "additionalProperties": false
    },
    "recovery": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "resource": { "type": "string", "enum": ["hp", "mp", "stamina", "ap"] },
            "mode": { "type": "string", "enum": ["full", "none"] }
          },
          "required": ["resource", "mode"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "resource": { "type": "string", "enum": ["hp", "mp", "stamina", "ap"] },
            "mode": { "type": "string", "const": "fraction" },
            "numerator": { "type": "integer", "minimum": 1 },
            "denominator": { "type": "integer", "minimum": 1 }
          },
          "required": ["resource", "mode", "numerator", "denominator"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "resource": { "type": "string", "const": "conditions" },
            "mode": { "type": "string", "const": "none" }
          },
          "required": ["resource", "mode"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "resource": { "type": "string", "const": "conditions" },
            "mode": { "type": "string", "const": "clear" },
            "durations": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "enum": ["turns", "uses"] },
              "uniqueItems": true
            }
          },
          "required": ["resource", "mode", "durations"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "empty sets toxicity to 0; none keeps it (docs/core/rest.md).",
          "properties": {
            "resource": { "type": "string", "const": "toxicity" },
            "mode": { "type": "string", "enum": ["empty", "none"] }
          },
          "required": ["resource", "mode"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "clear ends every running food effect (origin core:origin/food); none keeps them (docs/core/rest.md#food-at-rest).",
          "properties": {
            "resource": { "type": "string", "const": "food" },
            "mode": { "type": "string", "enum": ["clear", "none"] }
          },
          "required": ["resource", "mode"],
          "additionalProperties": false
        }
      ]
    }
  }
}
