{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Summon group",
  "description": "What a summon spell can call: a group of monster rows, named by a summon effect's parameter (docs/modules/magic.md#summon-groups).",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "summons": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/summon"
      }
    }
  },
  "required": [
    "summons"
  ],
  "additionalProperties": false,
  "definitions": {
    "summon": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "schema.json#/definitions/entryId"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "schema.json#/definitions/namespacedRef"
          },
          "description": "The monster rows the caster may pick from, as core:monster/<key>."
        }
      },
      "required": [
        "id",
        "key",
        "label",
        "description",
        "variants"
      ],
      "additionalProperties": false
    }
  }
}
