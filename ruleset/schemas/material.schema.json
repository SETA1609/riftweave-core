{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Material",
  "description": "One material identity. foundAs is how nature gives it. weapon, armor, and ingredient columns stamp the recipe output. A recipe does not refuse a material.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/material"
      }
    }
  },
  "required": [
    "materials"
  ],
  "additionalProperties": false,
  "definitions": {
    "column": {
      "type": "object",
      "properties": {
        "attack": {
          "type": "number"
        },
        "defense": {
          "type": "number"
        },
        "effectMagnitude": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "schema.json#/definitions/entryId"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "$ref": "schema.json#/definitions/sourceRef"
        },
        "foundAs": {
          "type": "string",
          "description": "Natural form. Not a lock on later recipes."
        },
        "phase": {
          "type": "string",
          "description": "Optional tag. A recipe must not require it."
        },
        "tier": {
          "type": "integer",
          "minimum": 1
        },
        "weapon": {
          "$ref": "#/definitions/column"
        },
        "armor": {
          "$ref": "#/definitions/column"
        },
        "ingredient": {
          "$ref": "#/definitions/column"
        },
        "weightFactor": {
          "type": "number",
          "minimum": 0
        },
        "valueFactor": {
          "type": "number",
          "minimum": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "appliesTo": {
          "type": "array",
          "description": "Old guard. Not the authority.",
          "items": {
            "type": "string"
          }
        },
        "modifiers": {
          "type": "object",
          "description": "Old combined column. Not the authority."
        }
      },
      "required": [
        "id",
        "key",
        "label",
        "foundAs",
        "weightFactor",
        "valueFactor"
      ],
      "additionalProperties": false
    }
  }
}
