{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Material",
  "description": "One material identity. found_as is how nature gives it. weapon, armor, and ingredient columns stamp the recipe output. A recipe does not refuse a material.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/material"
      }
    }
  },
  "required": [
    "materials"
  ],
  "additionalProperties": false,
  "definitions": {
    "column": {
      "type": "object",
      "properties": {
        "attack": {
          "type": "number"
        },
        "defense": {
          "type": "number"
        },
        "effect_magnitude": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "$ref": "schema.json#/definitions/sourceRef"
        },
        "found_as": {
          "type": "string",
          "description": "Natural form. Not a lock on later recipes."
        },
        "phase": {
          "type": "string",
          "description": "Optional tag. A recipe must not require it."
        },
        "tier": {
          "type": "integer",
          "minimum": 1
        },
        "weapon": {
          "$ref": "#/definitions/column"
        },
        "armor": {
          "$ref": "#/definitions/column"
        },
        "ingredient": {
          "$ref": "#/definitions/column"
        },
        "weight_factor": {
          "type": "number",
          "minimum": 0,
          "description": "Multiplies the base's weight; the result is in weight units (docs/core/contract.md#weight)."
        },
        "value_factor": {
          "type": "number",
          "minimum": 0
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "key",
        "label",
        "found_as",
        "weight_factor",
        "value_factor"
      ],
      "additionalProperties": false
    }
  }
}
