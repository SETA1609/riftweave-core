{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ingredient",
  "description": "An alchemical reagent. Its effects are ids drawn from the shared effect registry (data/effects); brewing combines ingredients that share an effect to produce a potion or poison.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "ingredients": {
      "type": "array",
      "items": { "$ref": "#/definitions/ingredient" }
    }
  },
  "required": ["ingredients"],
  "additionalProperties": false,
  "definitions": {
    "ingredient": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "source": { "$ref": "schema.json#/definitions/sourceRef" },
        "effects": {
          "type": "array",
          "description": "Effect ids this ingredient can impart (must have 'ingredient' in their channels). Magnitude/duration are derived at brew time from Alchemy skill.",
          "items": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "rarity": { "type": "string", "enum": ["common", "uncommon", "rare", "legendary"] },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "description", "effects"],
      "additionalProperties": false
    }
  }
}
