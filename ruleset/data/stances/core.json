{
  "$schema": "../../schemas/stance.schema.json",
  "rules": { "turn_start_ap": 0, "mid_turn_ap": 1, "parry_band_divisor": 4 },
  "stances": [
    {
      "key": "fencers_measure",
      "label": "Fencer's Measure",
      "description": "A one-handed blade and nothing in the other hand: the blade parries (a parry band of a quarter of its skill), and you gain +10 to attack while only one foe is in reach.",
      "main": ["light", "one_handed"],
      "off": ["empty"],
      "main_skills": ["core:skill/blades", "core:skill/piercing"],
      "modifiers": [
        {
          "target": "parry",
          "operation": "grant",
          "value": 1,
          "source": "stance:fencers_measure",
          "origin": "core:origin/martial",
          "duration": "while_applied"
        },
        {
          "target": "attack_single_opponent",
          "operation": "add",
          "value": 10,
          "source": "stance:fencers_measure",
          "origin": "core:origin/martial",
          "duration": "while_applied"
        }
      ]
    },
    {
      "key": "espada_y_daga",
      "label": "Espada y Daga",
      "description": "A blade in the main hand and a dagger in the off hand: the dagger does not strike in a full attack but parries, and after a parry the next main-hand strike gains +10.",
      "main": ["light", "one_handed"],
      "off": ["light_weapon"],
      "main_skills": ["core:skill/blades", "core:skill/piercing"],
      "off_skills": ["core:skill/piercing"],
      "modifiers": [
        {
          "target": "parry",
          "operation": "grant",
          "value": 1,
          "source": "stance:espada_y_daga",
          "origin": "core:origin/martial",
          "duration": "while_applied"
        },
        {
          "target": "off_hand_parries",
          "operation": "grant",
          "value": 1,
          "source": "stance:espada_y_daga",
          "origin": "core:origin/martial",
          "duration": "while_applied"
        },
        {
          "target": "attack_after_parry",
          "operation": "add",
          "value": 10,
          "source": "stance:espada_y_daga",
          "origin": "core:origin/martial",
          "duration": "while_applied"
        }
      ]
    },
    {
      "key": "buckler_play",
