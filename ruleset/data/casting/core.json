{
  "$schema": "../../schemas/casting.schema.json",
  "casting": {
    "summon_limit": 1,
    "bound_weapon": { "material": "core:material/iron", "damage_type": "magic" },
    "prevented_by": ["silenced"],
    "armor_penalty": { "none": 0, "light": -5, "medium": -15, "heavy": -30 },
    "shield_penalty": { "none": 0, "buckler": 0, "standard": -5, "tower": -15 },
    "save": { "attribute_multiplier": 10, "full_margin": 30, "partial_percent": 50 },
    "skill_discount": { "divisor": 200, "cap": 0.45, "minimum_paid": 1 },
    "spell_cost": {
      "magnitude_factor": 0.1,
      "area_factor": 0.05,
      "target_multiplier": { "self": 1.0, "touch": 1.0, "ranged": 1.5, "area": 2.0, "world": 3.0 }
    },
    "research": { "days": 7, "cost": { "quantity": 50, "unit": "gold" } }
  }
}
