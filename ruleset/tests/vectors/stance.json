  {
    "name": "replace: Forward Guard replaces Low Guard mid-turn for 1 AP, and only Forward Guard's modifiers apply",
    "perks": [
      "core:feature/low_guard",
      "core:feature/forward_guard"
    ],
    "loadout": {
      "main": "two_handed",
      "off": "two_handed"
    },
    "stance": "low_guard",
    "events": [
      {
        "take": "forward_guard",
        "mid_turn": true
      }
    ],
    "expect": {
      "stance": "forward_guard",
      "ap": 1,
      "modifiers": [
        {
          "target": "attack_roll",
          "operation": "add",
          "value": 10,
          "source": "stance:forward_guard",
          "origin": "core:origin/martial",
          "duration": "while_applied"
        },
        {
          "target": "evasion_band",
          "operation": "add",
          "value": -10,
          "source": "stance:forward_guard",
          "origin": "core:origin/martial",
          "duration": "while_applied"
        }
      ],
      "steps": [
        {
          "ap": 1,
          "ended": "low_guard",
          "stance": "forward_guard"
        }
      ]
    }
  },
