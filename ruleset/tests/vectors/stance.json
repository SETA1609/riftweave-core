[
  {
    "name": "take: Fencer's Measure at the start of the turn is free; a rapier alone fits, and its modifiers come back martial and while applied",
    "perks": [
      "core:feature/fencers_measure"
    ],
    "loadout": {
      "main": "light",
      "off": "empty",
      "main_skill": "core:skill/piercing"
    },
    "events": [
      {
        "take": "fencers_measure"
      }
    ],
    "expect": {
      "stance": "fencers_measure",
      "ap": 0,
      "modifiers": [
        {
          "target": "parry",
          "operation": "grant",
          "value": 1,
          "source": "stance:fencers_measure",
          "origin": "core:origin/martial",
          "duration": "while_applied"
        },
        {
          "target": "attack_single_opponent",
          "operation": "add",
          "value": 10,
          "source": "stance:fencers_measure",
          "origin": "core:origin/martial",
          "duration": "while_applied"
        }
      ],
      "steps": [
        {
          "ap": 0,
          "ended": null,
          "stance": "fencers_measure"
        }
      ]
    }
  },
