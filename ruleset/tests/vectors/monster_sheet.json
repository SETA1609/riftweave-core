  {
    "name": "error: an unknown skill",
    "monster": {
      "attributes": {
        "str": 4,
        "per": 4,
        "end": 4,
        "int": 5,
        "wil": 2,
        "agi": 6,
        "cha": 3,
        "lck": 3
      }
