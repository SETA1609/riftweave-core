[
  {
    "name": "computed: the player formulas, level 3",
    "monster": {
      "attributes": {
        "str": 4,
        "per": 4,
        "end": 4,
        "int": 5,
        "wil": 2,
        "agi": 6,
        "cha": 3,
        "lck": 3
      },
      "level": 3
    },
    "expect": {
      "hp": 59,
      "mp": 46,
      "ap": 4,
      "carry": 65,
      "initiative": 4,
      "skills": {},
      "sp": 36
    }
  },
  {
    "name": "the same attributes and level as a player give the same stats",
    "function": "derived",
    "actor": {
      "attributes": {
        "str": 4,
        "per": 4,
        "end": 4,
        "int": 5,
        "wil": 2,
        "agi": 6,
        "cha": 3,
        "lck": 3
      },
      "level": 3
    },
    "expect": {
      "hp": 59,
      "mp": 46,
      "ap": 4,
      "carry": 65,
      "initiative": 4,
      "sp": 36
    }
  },
  {
    "name": "authored hitPoints replaces only the computed hp",
    "monster": {
      "attributes": {
        "str": 4,
        "per": 4,
        "end": 4,
        "int": 5,
        "wil": 2,
        "agi": 6,
        "cha": 3,
        "lck": 3
      },
      "level": 3,
      "hitPoints": 33
    },
    "expect": {
      "hp": 33,
      "mp": 46,
      "ap": 4,
      "carry": 65,
      "initiative": 4,
      "skills": {},
      "sp": 36
    }
  },
  {
    "name": "no level reads as level 1",
    "monster": {
      "attributes": {
        "end": 4
      }
    },
    "expect": {
      "hp": 51,
      "mp": 2
    }
  },
  {
    "name": "a written skill is read as written",
    "monster": {
      "attributes": {
        "str": 4,
        "per": 4,
        "end": 4,
        "int": 5,
        "wil": 2,
        "agi": 6,
        "cha": 3,
        "lck": 3
      },
      "level": 3,
      "skills": {
        "blades": 60
      }
    },
    "read_skills": [
      "blades"
    ],
    "expect": {
      "skills": {
        "blades": 60
      }
    }
  },
  {
    "name": "an unwritten skill is a starting value",
    "monster": {
      "attributes": {
        "str": 4,
        "per": 4,
        "end": 4,
        "int": 5,
        "wil": 2,
        "agi": 6,
        "cha": 3,
        "lck": 3
      },
      "level": 3,
      "skills": {
        "blades": 60
      }
    },
    "read_skills": [
      "stealth"
    ],
    "expect": {
      "skills": {
        "stealth": 17
      }
    }
  },
  {
    "name": "a missing attribute reads 0 for a starting value",
    "monster": {
      "attributes": {
        "end": 4
      }
    },
    "read_skills": [
      "stealth"
    ],
    "expect": {
      "skills": {
        "stealth": 5
      }
    }
  },
  {
    "name": "growth: at level 1 a fighting skill is its starting value",
    "monster": {
      "attributes": {
        "str": 6,
        "per": 4,
        "end": 4,
        "int": 5,
        "wil": 2,
        "agi": 5,
        "cha": 3,
        "lck": 3
      },
      "level": 1
    },
    "read_skills": [
      "evasion",
      "blades"
    ],
    "expect": {
      "skills": {
        "evasion": 15,
        "blades": 17
      }
    }
  },
  {
    "name": "growth: at level 5 combat and magic skills gain 17 per level, stealth stays at its start",
    "monster": {
      "attributes": {
        "str": 6,
        "per": 4,
        "end": 4,
        "int": 5,
        "wil": 2,
        "agi": 5,
        "cha": 3,
        "lck": 3
      },
      "level": 5
    },
    "read_skills": [
      "evasion",
      "blades",
      "red_magic",
      "stealth"
    ],
    "expect": {
      "skills": {
        "evasion": 83,
        "blades": 85,
        "red_magic": 83,
        "stealth": 15
      }
    }
  },
  {
    "name": "growth: a grown skill stops at the skill cap of 100",
    "monster": {
      "attributes": {
        "str": 6,
        "per": 4,
        "end": 4,
        "int": 5,
        "wil": 2,
        "agi": 5,
        "cha": 3,
        "lck": 3
      },
      "level": 8
    },
    "read_skills": [
      "evasion",
      "blades"
    ],
    "expect": {
      "skills": {
        "evasion": 100,
        "blades": 100
      }
    }
  },
  {
    "name": "growth: a written skill does not grow",
    "monster": {
      "attributes": {
        "str": 6,
        "per": 4,
        "end": 4,
        "int": 5,
        "wil": 2,
        "agi": 5,
        "cha": 3,
        "lck": 3
      },
      "level": 10,
      "skills": {
        "blades": 40
      }
    },
    "read_skills": [
      "blades",
      "evasion"
    ],
    "expect": {
      "skills": {
        "blades": 40,
        "evasion": 100
      }
    }
  },
  {
    "name": "perks: Toughness at rank 2 adds 30 to an authored hitPoints",
    "monster": {
      "attributes": {
        "str": 6,
        "per": 4,
        "end": 4,
        "int": 5,
        "wil": 2,
        "agi": 5,
        "cha": 3,
        "lck": 3
      },
      "level": 3,
      "hitPoints": 59,
